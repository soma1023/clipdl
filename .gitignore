# 仮想環境
.venv/

# vendor のバイナリ（取得手順とハッシュは vendor/CHECKSUMS.txt で管理）
vendor/*
!vendor/CHECKSUMS.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ビルド成果物
build/
dist/

# 動作確認の出力
out/
*.part
*.ytdl

# モックの生成物（build_mockup.py が作る中間ファイル）
docs/mockup/_render.html

# 秘密鍵（リポジトリには絶対に入れない。保存先は packaging/keygen.py を参照）
*.pem
*.key.private

# チャットのデザイン比較の画像（実在の配信のチャットが写っているため、リポジトリに入れない）
docs/chat-style/
